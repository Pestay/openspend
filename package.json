{
  "name": "openspend",
  "private": true,
  "version": "0.9.2",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "pnpm build && vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply openspend --local",
    "db:migrate:remote": "wrangler d1 migrations apply openspend --remote",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "vitest run",
    "admin": "node scripts/admin.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=22"
  }
}
