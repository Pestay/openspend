# Copia este archivo a .dev.vars (está en .gitignore) y completa los valores.
# En producción los secretos se configuran con: pnpm exec wrangler secret put <NOMBRE>

PUBLIC_URL=http://localhost:5173

# Aplicación de Auth0 (Regular Web Application). Callback: http://localhost:5173/auth/callback
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Firma de cookies de sesión y consentimiento. Generar con: openssl rand -base64 32
SESSION_SECRET=

# Opcional: Client ID de la Native app de Auth0 (app móvil). Sin él, la API solo acepta la cookie.
# AUTH0_NATIVE_CLIENT_ID=
